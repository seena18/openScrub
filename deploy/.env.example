POSTGRES_DB=privacy_scrubber
POSTGRES_USER=privacy
POSTGRES_PASSWORD=privacy_change_me

DATABASE_URL=postgresql://privacy:privacy_change_me@postgres:5432/privacy_scrubber
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_PREFIX=rl

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_change_me
OBJECT_STORAGE_BUCKET=scrubber-evidence
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio_change_me
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PUBLIC_BASE_URL=

API_PORT=8080
API_BEARER_TOKEN=change-me-automation-token
JWT_SECRET=change-me-jwt-secret-very-long-random-string
JWT_EXPIRES_MINUTES=60
REFRESH_JWT_EXPIRES_MINUTES=10080
ALLOW_SELF_REGISTER=false
IDENTIFIER_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
ENABLE_INSECURE_RESET_TOKEN_RESPONSE=false
MFA_POLICY_MODE=off
MFA_PRIVILEGED_ROLES=owner,admin
MFA_TOTP_ISSUER=Privacy Scrubber
MFA_TOTP_VALID_WINDOW=1
MFA_TOTP_DISABLE_REQUIRES_CODE=true
# Optional dedicated key for TOTP secrets. If empty, IDENTIFIER_ENCRYPTION_KEY is used.
MFA_TOTP_ENCRYPTION_KEY=
MFA_WEBAUTHN_RP_ID=localhost
MFA_WEBAUTHN_RP_NAME=Privacy Scrubber
# Comma-separated origins allowed for WebAuthn ceremony verification.
MFA_WEBAUTHN_ORIGINS=https://localhost
MFA_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
MFA_WEBAUTHN_TIMEOUT_MS=60000
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=8
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_WEBAUTHN_VERIFY_SETUP_MAX_ATTEMPTS=10
RATE_LIMIT_WEBAUTHN_VERIFY_SETUP_WINDOW_SECONDS=300
RATE_LIMIT_WEBAUTHN_FINISH_MAX_ATTEMPTS=10
RATE_LIMIT_WEBAUTHN_FINISH_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
RATE_LIMIT_LOGOUT_MAX_ATTEMPTS=60
RATE_LIMIT_LOGOUT_WINDOW_SECONDS=300
RATE_LIMIT_CHANGE_PASSWORD_MAX_ATTEMPTS=10
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX_ATTEMPTS=6
RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_MAX_ATTEMPTS=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=900

WORKER_INTERVAL_SECONDS=10
ADAPTER_RUN_TIMEOUT_SECONDS=120
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
RETENTION_CLEANUP_DRY_RUN=true
RETENTION_CLEANUP_REVOKED_REFRESH_GRACE_DAYS=7
RETENTION_CLEANUP_INCLUDE_ADAPTER_ARTIFACTS=false
RETENTION_CLEANUP_ADAPTER_ARTIFACT_MAX_AGE_DAYS=30
RETENTION_CLEANUP_INCLUDE_IDEMPOTENCY_KEYS=true
RETENTION_CLEANUP_IDEMPOTENCY_MAX_AGE_DAYS=30
